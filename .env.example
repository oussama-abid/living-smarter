# Copy this file to .env and fill in your own values.
# .env is ignored by Git: never commit real keys.

# Required: Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: which Gemini models to use (defaults shown)
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_HELPER_MODEL=gemini-3.5-flash-lite

# Optional: web search with Tavily (https://tavily.com)
TAVILY_API_KEY=

# Optional: voice mode, speech-to-text and text-to-speech with Deepgram (https://deepgram.com)
DEEPGRAM_API_KEY=

# Optional: where the simulated smart home is stored (created on first start)
# DATABASE_PATH=devices.db

# Optional: Gmail tool. Download an OAuth client ("Desktop app") from Google Cloud
# and save it here. The token file is created after the first login.
# GOOGLE_CREDENTIALS_PATH=secrets/credentials.json
# GOOGLE_TOKEN_PATH=secrets/token.json

# Optional: browser for the YouTube tool, e.g. Brave
# BROWSER_BINARY=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe
